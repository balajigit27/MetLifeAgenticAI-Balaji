# ============================================================================
# AGENTIC RESEARCH ORCHESTRATOR - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# LLM MODE SELECTION
# ============================================================================
# Options: "cloud" (OpenAI) or "local" (Ollama)
# DEFAULT: "cloud"
LLM_MODE=cloud

# ============================================================================
# OPENAI CONFIGURATION (for cloud mode)
# ============================================================================
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here
# Model options: gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo
# Temperature (0.0 to 1.0): Lower = more deterministic, Higher = more creative
OPENAI_TEMPERATURE=0.3
# Max tokens per request
OPENAI_MAX_TOKENS=4096

# ============================================================================
# OLLAMA CONFIGURATION (for local mode)
# ============================================================================
# Ollama server endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model options: llama2, mistral, neural-chat, dolphin-mixtral, etc.
OLLAMA_MODEL=mistral
# Temperature
OLLAMA_TEMPERATURE=0.3
# Max tokens
OLLAMA_MAX_TOKENS=4096

# ============================================================================
# RESEARCH ORCHESTRATOR SETTINGS
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Output directory for research reports
REPORTS_DIR=./reports
# Database path for persistence
DB_PATH=./research.db

# ============================================================================
# LANGSMITH OBSERVABILITY (Optional)
# ============================================================================
# Enable LangSmith tracing (true/false)
LANGSMITH_ENABLED=false
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=
# Project name for organizing traces
LANGSMITH_PROJECT=agentic-research

# ============================================================================
# RESEARCH PARAMETERS
# ============================================================================
# Default research depth: quick, standard, deep
DEFAULT_RESEARCH_DEPTH=standard
# Max web search results per query
MAX_SEARCH_RESULTS=5
# Request timeout in seconds
REQUEST_TIMEOUT=30
# Max retries for failed API calls
MAX_RETRIES=3

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable checkpoint persistence (pause/resume)
ENABLE_CHECKPOINTS=true
# Enable structured logging (JSON format)
JSON_LOGGING=false
# Enable debug mode (verbose output)
DEBUG_MODE=false
